using System.Text;

namespace StateCheckpoint.NET.Tests
{
    internal class Grid
    {
         private bool[,] Mask {  get; set; }

        public Grid(int size) 
        {
            Mask = new bool[size, size];
        }

        public override string ToString()
        {
            if (Mask == null) return string.Empty;

            var n = Mask.GetLength(0);
            var sb = new StringBuilder(n * n);
            for (var rw = 0; rw < n; rw++)
            {
                for (var col = 0; col < n; col++)
                {
                    sb.Append(Mask[rw, col].ToString());
                }

                if (rw < n) sb.Append(Environment.NewLine);
            }

            return sb.ToString();
        }

        public void MaskAt(int row, int column)
        {
            var length = Mask.GetLength(0) - 1;
            if (column < 0 || row < 0 || column > length || row > length) return;

            Mask[row, column] = true;
        }

        public void MaskAdjacent(int row, int column)
        {
            var length = Mask.GetLength(0) - 1;
            var rowStart = row <= 0 ? 0 : row - 1;
            var columnStart = column <= 0 ? 0 : column - 1;
            var colEnd = column+1 >= 0 && column+1 <= length ? column + 1 : length;
            var rwEnd = row+1 >= 0 && row+1 <= length ? row + 1 : length;

            for (var rw = rowStart; rw <= rwEnd; rw++)
            {
                for (var col = columnStart; col <= colEnd; col++)
                {
                    MaskAt(rw, col);
                }
            }
        }

        public void Reset()
        {
            Array.Clear(Mask, 0, Mask.Length);
        }
    }
}
